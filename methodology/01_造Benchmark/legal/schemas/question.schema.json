{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-eval.local/schemas/legal-question.schema.json",
  "title": "Legal benchmark question",
  "description": "法律 Benchmark 正式题目契约。context 与 question 分离，保证被测模型收到的材料可独立组织。",
  "type": "object",
  "required": [
    "question_id",
    "case_id",
    "split",
    "case_classification",
    "dimension_id",
    "primary_issue",
    "task_type",
    "reasoning_capabilities",
    "answer_type",
    "context_type",
    "context",
    "scoring_method",
    "difficulty",
    "risk_level",
    "question",
    "reference_answer",
    "rubric",
    "source_evidence"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "calibration", "test"]},
    "case_classification": {"type": "object"},
    "dimension_id": {
      "type": "string",
      "enum": [
        "fact_extraction",
        "issue_identification",
        "rule_application",
        "evidence_evaluation",
        "judgment_prediction",
        "legal_argument",
        "amount_calculation",
        "compliance_refusal",
        "procedure_time_reasoning"
      ]
    },
    "primary_issue": {"type": "string", "minLength": 1},
    "task_type": {
      "type": "string",
      "enum": [
        "事实抽取",
        "争议焦点识别",
        "争议焦点识别与规则适用",
        "法律规则适用",
        "证据评价",
        "裁判结果预测",
        "法律论证",
        "金额计算",
        "合规拒答",
        "程序与时间推理"
      ]
    },
    "reasoning_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "answer_type": {
      "type": "string",
      "enum": ["短答案", "结构化论述", "金额", "标签", "拒答与替代建议"]
    },
    "context_type": {
      "type": "string",
      "enum": ["source_excerpt", "full_document", "self_contained", "scenario"]
    },
    "context": {"type": "string", "minLength": 1},
    "scoring_method": {"enum": ["rule", "redline", "rubric_judge"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "question": {"type": "string", "minLength": 1},
    "reference_answer": {"type": "string", "minLength": 1},
    "rubric": {"type": "object"},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_section", "source_quote"],
        "properties": {
          "source_section": {"type": "string", "minLength": 1},
          "source_quote": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
