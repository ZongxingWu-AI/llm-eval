{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legal benchmark question",
  "type": "object",
  "required": [
    "question_id", "case_id", "split", "case_classification", "primary_issue",
    "task_type", "reasoning_capabilities", "answer_type", "scoring_method",
    "difficulty", "risk_level", "question", "reference_answer", "rubric", "source_evidence"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "calibration", "test"]},
    "case_classification": {"type": "object"},
    "reasoning_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scoring_method": {"enum": ["rule", "redline", "rubric_judge"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "question": {"type": "string", "minLength": 1},
    "reference_answer": {"type": "string", "minLength": 1},
    "rubric": {"type": "object"},
    "source_evidence": {"type": "array", "minItems": 1}
  }
}
