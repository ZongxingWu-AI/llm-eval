# DeepSeek API 配置（复制为 .env 后填入真实 key，.env 不要提交到 git）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 思考类模型需要较大 max_tokens（脚本默认 8192），非思考模型可调小
DEEPSEEK_MAX_TOKENS=8192

# ===== 选手 / 裁判的模型配置（OpenAI 兼容接口，可各自换模型）=====
# 未填写时自动回退到上面的 DEEPSEEK_*；想换模型就填对应前缀。
# 选手 A 默认 deepseek-v4-flash。
CONTESTANT_A_BASE_URL=
CONTESTANT_A_API_KEY=
CONTESTANT_A_MODEL=deepseek-v4-flash

# 选手 B 默认 deepseek-v4-pro。
CONTESTANT_B_BASE_URL=
CONTESTANT_B_API_KEY=
CONTESTANT_B_MODEL=deepseek-v4-pro

# 主裁判（必用）默认 deepseek-v4-flash。
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-v4-flash

# 可选的第 2、3 个裁判（跨模型族去自我偏好用）。
# 只有填了下面的任一配置才会启用；不填就不参与投票。
JUDGE_2_BASE_URL=
JUDGE_2_API_KEY=
JUDGE_2_MODEL=

JUDGE_3_BASE_URL=
JUDGE_3_API_KEY=
JUDGE_3_MODEL=

# 国内其他模型的地址示例（填好 key 后把任意角色改成对应前缀即可）：
# 千问/Qwen:      BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MODEL=qwen-plus
# MiniMax:        BASE_URL=https://api.minimax.chat/v1
# Kimi(月之暗面):  BASE_URL=https://api.moonshot.cn/v1  MODEL=moonshot-v1-8k
# 智谱 GLM:        BASE_URL=https://open.bigmodel.cn/api/paas/v4  MODEL=glm-4-plus
