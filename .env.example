# DeepSeek API 配置（复制为 .env 后填入真实 key，.env 不要提交到 git）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=8192

# ===== 选手 / 裁判的模型配置（OpenAI 兼容接口，可各自换模型）=====
CONTESTANT_A_BASE_URL=
CONTESTANT_A_API_KEY=
CONTESTANT_A_MODEL=deepseek-v4-flash
CONTESTANT_B_BASE_URL=
CONTESTANT_B_API_KEY=
CONTESTANT_B_MODEL=deepseek-v4-pro
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-v4-flash
JUDGE_2_BASE_URL=
JUDGE_2_API_KEY=
JUDGE_2_MODEL=
JUDGE_3_BASE_URL=
JUDGE_3_API_KEY=
JUDGE_3_MODEL=

# ===== 法律 Benchmark 角色 =====
# GENERATOR 可以按项目现有规则回退通用配置；生产审题不得使用这种回退。
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
GENERATOR_MODEL=deepseek-v4-flash

EXTRACTOR_BASE_URL=
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=deepseek-v4-flash

# Reviewer 必须显式配置，不能回退 DEEPSEEK_*、GENERATOR_* 或 JUDGE_*。
# 且 REVIEWER_BASE_URL + REVIEWER_MODEL 必须与 Generator 不同。
REVIEWER_BASE_URL=
REVIEWER_API_KEY=
REVIEWER_MODEL=
